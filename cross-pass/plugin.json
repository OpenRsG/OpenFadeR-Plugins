{
  "name": "cross-pass",
  "version": "0.2.0",
  "description": "CROSS-PASS filter of the Pioneer DJ DJM-V5: a Sound Color FX that keeps the lows (below 150 Hz) and filters the mids and highs: left a low-pass closes them (20 kHz down to 300 Hz), right a high-pass opens over them (20 Hz up to 8 kHz), the centre passes the signal exactly.",
  "effects": [
    {
      "name": "CROSS-PASS",
      "slot": "color",
      "chain": [
        {
          "block": "crossover",
          "freq": 150,
          "high": [
            {
              "block": "parallel",
              "branches": [
                [
                  {
                    "block": "filter",
                    "type": "lp",
                    "hz": "expo(20k, 300, abs(knob))"
                  },
                  {
                    "block": "gain",
                    "gain": "if(knob < 0, 1, 0)"
                  }
                ],
                [
                  {
                    "block": "filter",
                    "type": "hp",
                    "hz": "expo(20, 8k, abs(knob))"
                  },
                  {
                    "block": "gain",
                    "gain": "if(knob > 0, 1, 0)"
                  }
                ]
              ]
            }
          ]
        },
        {
          "block": "mix",
          "amount": "if(knob == 0, 0, level * g)"
        }
      ]
    }
  ]
}
